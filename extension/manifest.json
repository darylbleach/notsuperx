{
  "manifest_version": 3,
  "name": "NotSuperX",
  "version": "1.0.0",
  "description": "Sidebar on x.com: analytics, queue, AI replies, save viral posts to your NotSuperX library.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://*/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }],
  "options_page": "options.html",
  "action": { "default_title": "NotSuperX", "default_popup": "options.html" }
}
